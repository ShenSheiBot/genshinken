{
  "name": "genshinken",
  "version": "1.0.0",
  "private": true,
  "description": "屋顶现视研 — 动画、漫画、游戏与视听文化的评论和译介站点",
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "node --experimental-strip-types --no-warnings scripts/validate-content.mjs",
    "audit:roof-archive": "node scripts/audit-roof-archive.mjs",
    "audit:tags": "node scripts/audit-tags.mjs",
    "assets:manifest": "node scripts/manage-roof-assets.mjs build",
    "assets:upload": "node scripts/manage-roof-assets.mjs upload",
    "assets:verify": "node scripts/manage-roof-assets.mjs verify",
    "assets:wechat:manifest": "node scripts/manage-wechat-assets.mjs build",
    "assets:wechat:upload": "node scripts/manage-wechat-assets.mjs upload",
    "assets:wechat:verify": "node scripts/manage-wechat-assets.mjs verify",
    "assets:wechat:release": "node scripts/manage-wechat-assets.mjs release",
    "preservation:wechat:build": "node scripts/manage-wechat-preservation.mjs build",
    "verify:snapshot-history": "node scripts/verify-editorial-snapshot-history.mjs",
    "verify:preservation": "node scripts/verify-source-preservation.mjs",
    "sync:preserved": "node scripts/verify-source-preservation.mjs --write",
    "validate:media-html": "node --experimental-strip-types --no-warnings scripts/verify-media-sanitizer.mjs",
    "verify:typography": "node --experimental-strip-types --no-warnings scripts/verify-markdown-typography.mjs",
    "verify:typography-registry": "node scripts/verify-typography-registry.mjs",
    "verify:negative": "node --experimental-strip-types --no-warnings scripts/verify-negative-section.mjs",
    "verify:fonts": "node scripts/verify-font-contract.mjs",
    "verify:reading-progress": "node --experimental-strip-types --no-warnings scripts/verify-reading-progress.mjs",
    "verify:han-script": "node --experimental-strip-types --no-warnings scripts/verify-han-script.mjs",
    "verify:citations": "node --experimental-strip-types --no-warnings scripts/verify-citations.mjs",
    "verify:dependencies": "node scripts/verify-dependency-contract.mjs",
    "verify:routing": "node --experimental-strip-types --no-warnings scripts/verify-static-routing.mjs",
    "verify:library": "node --experimental-strip-types --no-warnings scripts/verify-library-filter.mjs",
    "verify:editorial": "node scripts/verify-editorial-release.mjs",
    "verify:no-new-wechat-assets": "node scripts/verify-no-new-wechat-assets.mjs",
    "verify:wechat-assets-ready": "node scripts/verify-wechat-assets-ready.mjs",
    "verify:wechat-preservation": "node --test tests/manage-wechat-preservation.test.mjs && node scripts/manage-wechat-preservation.mjs verify",
    "verify:structured-credits": "node scripts/verify-structured-credit-lines.mjs",
    "verify:license-placement": "node scripts/verify-license-placement.mjs",
    "verify:release": "node scripts/verify-editorial-release.mjs",
    "check": "npm run validate:content && npm run validate:media-html && npm run verify:wechat-assets-ready && npm run verify:wechat-preservation && npm run verify:structured-credits && npm run verify:license-placement && npm run verify:typography && npm run verify:typography-registry && npm run verify:reading-progress && npm run verify:han-script && npm run verify:citations && npm run verify:routing && npm run verify:library && npm run verify:fonts && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "next": "15.5.21",
    "opencc-js": "^1.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sanitize-html": "^2.17.6",
    "sharp": "0.35.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "3.15.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "postcss": "8.5.19",
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.21",
    "typescript": "^5.7.3",
    "wrangler": "^4.121.0"
  }
}
