{
  "name": "un-canon-blog",
  "version": "1.0.0",
  "private": true,
  "description": "西方負典 / UN-CANON — 新粗野主义人文随笔站 (Next.js + Markdown)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:media-html": "node --experimental-strip-types --no-warnings scripts/verify-media-sanitizer.mjs",
    "verify:editorial": "node scripts/verify-editorial-release.mjs",
    "check": "npm run validate:content && npm run validate:media-html && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sanitize-html": "^2.17.6",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.19",
    "typescript": "^5.7.3"
  }
}
