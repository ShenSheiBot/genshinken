# Exact crawler snapshots stay as local editorial evidence. Commit the
# human-authored cv*-evidence/editorial-note Markdown, not complete page state.
/editorial-sources/roof-archive/cv*.json
/editorial-sources/roof-archive/cv*/source.json
/public/roof-archive/

# WeChat crawl assets stay local. Existing published files under this path remain
# tracked, but Git must not acquire new crawler images from it.
/public/attachments/wechat/

# Proofreading packets are reproducible local review artifacts.
/editorial-sources/translations/proofreading/

# Planning scratch stays local and must not enter product history.
/docs/plans/
